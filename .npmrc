# Isolated (pnpm's default) is THE POINT of using pnpm here: a package that src/
# imports but package.json does not declare must fail loudly at install time
# instead of silently resolving through a flat, hoisted tree. 27 such "phantom"
# imports existed before the migration off yarn classic.
# Do NOT add `shamefully-hoist` — it re-hides exactly this bug class.
node-linker=isolated

# Load-bearing here, not decorative: two Plate generations coexist
# (@udecode/plate@39 and platejs@52 / @platejs/*@51) and share the slate peer
# set. Two physical slate-react copies is a silent React-context break that no
# test in this repo would catch.
dedupe-peer-dependents=true

# ~290 devDependencies across two Plate generations WILL have mismatched peers
# (React 19 against packages whose peers say ^18, etc). Both of these are pnpm
# defaults; they are stated explicitly so nobody "hardens" them later and bricks
# install. auto-install-peers reproduces yarn-1's de-facto behaviour of peers
# just being present, which is what the current source assumes.
strict-peer-dependencies=false
auto-install-peers=true

# Replaces `yarn install --network-timeout 1000000000`, which every workflow and
# the Dockerfile used to pass. pnpm has no --network-timeout flag.
fetch-timeout=600000
fetch-retries=5
